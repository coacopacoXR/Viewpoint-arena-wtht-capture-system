# ─────────────────────────────────────────────────────────────────────────────
# Viewpoint Arena — environment variables
# ─────────────────────────────────────────────────────────────────────────────
#
# This file is the CREDENTIAL STORE.  The primary interface for configuring
# which connectors are active is viewpoint.config.ts (see
# viewpoint.config.example.ts for a template).  The config file references
# these variables by NAME; their VALUES live here and in the deployment's
# secret manager.
#
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  VITE_ PREFIX RULE
# ─────────────────────────────────────────────────────────────────────────────
#
# Any variable prefixed VITE_ is INLINED INTO THE CLIENT BUNDLE by Vite at
# build time and shipped to every browser that loads the app.  A secret in a
# VITE_ variable is a PUBLIC secret.
#
# The ONLY approved VITE_ variables in this project are:
#
#   VITE_SUPABASE_URL         — public Supabase project URL
#   VITE_SUPABASE_ANON_KEY    — public Supabase anon key (client-safe by
#                                design; access control is enforced by Postgres
#                                Row Level Security, not by key secrecy)
#
# Every other credential MUST use an unprefixed name and be read only in
# server-side code (api/* functions or capture-service).  The master config
# schema enforces this: it rejects VITE_-prefixed names on all fields except
# db.urlEnv and db.anonKeyEnv.
#
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.  Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────


# ── PLM — Onshape ────────────────────────────────────────────────────────────
# Onshape OAuth application credentials.
# Create an Onshape dev account at https://dev-portal.onshape.com/

# Server-only — Onshape OAuth client ID
ONSHAPE_CLIENT_ID=your_onshape_client_id

# Server-only — Onshape OAuth client secret
ONSHAPE_CLIENT_SECRET=your_onshape_client_secret


# ── PLM — Teamcenter (alternative to Onshape) ────────────────────────────────
# Siemens Teamcenter credentials.

# Server-only — Teamcenter service username
TC_USERNAME=your_teamcenter_username

# Server-only — Teamcenter service password
TC_PASSWORD=your_teamcenter_password


# ── TURN — Cloudflare ────────────────────────────────────────────────────────
# Cloudflare Calls TURN service for WebRTC relay.

# Server-only — TURN application token ID
CF_TURN_TOKEN_ID=your_cloudflare_turn_token_id

# Server-only — TURN API token (secret)
CF_TURN_API_TOKEN=your_cloudflare_turn_api_token


# ── TURN — self-hosted coturn (alternative to Cloudflare) ────────────────────

# Server-only — coturn shared secret (TURN REST API: use-auth-secret)
COTURN_SHARED_SECRET=your_coturn_shared_secret

# The IP coturn advertises in ICE candidates. Leave empty for a same-machine
# install. Set to the host's LAN IP under Docker Desktop so off-machine
# browsers can reach the relay.
TURN_EXTERNAL_IP=

# Relay port range (must match docker-compose.yml coturn service).
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Set to a non-empty value (e.g. 'yes') to allow the relay to forward to
# private IP ranges. Needed when both browsers are on 192.168.x and there is
# no public-route coturn. Leave empty for the default deny list.
#TURN_ALLOW_PRIVATE_PEERS=


# ── Database — Supabase ──────────────────────────────────────────────────────
# The bundled database (default): the compose stack runs supabase/postgres +
# PostgREST + Realtime, and nginx-proxy routes /rest/v1/ and /realtime/v1/
# from the same origin as the app. install.sh generates VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY automatically for this mode.
#
# For an external Supabase project, paste its URL and anon key instead.
# Both are VITE_-prefixed because the browser reads them directly. The anon
# key is client-safe by design — access control is enforced by Postgres RLS.

# PUBLIC (client bundle) — Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# PUBLIC (client bundle) — Supabase anon key (RLS-protected, not a secret)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key


# ── Database — JWT infrastructure (bundled mode) ─────────────────────────────
# These are generated by install.sh and preserved across re-runs. Changing
# JWT_SECRET invalidates every anon key already issued; changing
# REALTIME_DB_ENC_KEY makes encrypted Realtime rows unreadable.

# Server-only — HS256 secret for signing and verifying JWTs
JWT_SECRET=

# Server-only — Phoenix secret for Realtime's session encryption
SECRET_KEY_BASE=

# Server-only — AES-128 key for Realtime tenant data (EXACTLY 16 characters)
REALTIME_DB_ENC_KEY=

# Server-only — the anon key (same value as VITE_SUPABASE_ANON_KEY)
ANON_KEY=


# ── Access control (optional) ──────────────────────────────────────────────
# Two shared secrets that gate access to the app and its admin settings.
# Both are OPTIONAL and empty by default — an existing install behaves
# exactly as today (open) until the operator sets them via ./install.sh.
#
# These are SHARED passwords, not per-person accounts. Anyone with the
# password gets in; the app cannot tell one person from another. This is
# deliberate — see docs/plan/11-accounts-and-admin.md §M.
#
# Values are salted SHA-256 hashes: <16-hex-salt>:<64-hex-sha256(salt+pw)>.
# A colon, not a "$": Docker Compose eats an unescaped "$" in .env values.
# The plaintext passwords are never stored. Re-run ./install.sh to change.

# Server-only — salted hash of the front-door password (empty = open)
ACCESS_PASSWORD_HASH=

# Server-only — salted hash of the admin passphrase (empty = no admin screen)
ADMIN_PASSPHRASE_HASH=


# ── AI Capture — cloud LLM providers ─────────────────────────────────────────
# Only needed when viewpoint.config.ts sets capture.provider to 'openai' or
# 'anthropic'.  The browser never sees these: api/capture/extract.ts reads them
# from server-side process.env and proxies the call.  The default capture
# provider ('mock') needs no key at all, and 'ollamaDirect' deliberately has
# none — that mode talks to a LAN Ollama instance and nothing leaves the
# network.
#
# The variable NAME each provider reads comes from capture.apiKeyEnv in
# viewpoint.config.ts; the two below are the defaults used when the config
# does not name one.

# Server-only — OpenAI API key
OPENAI_API_KEY=your_openai_api_key

# Server-only — Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key


# ── Notifications — Microsoft Teams ──────────────────────────────────────────
# Incoming webhook URL for Teams channel notifications.

# Server-only — Teams incoming webhook URL (bearer credential)
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/...


# ── Master config as JSON (Vercel / serverless) ──────────────────────────────
# Vercel and other hosts without a config file: the output of `npm run config:json`.
#VIEWPOINT_CONFIG=
