# ─────────────────────────────────────────────────────────────────────────────
# Viewpoint Arena — environment variables
# ─────────────────────────────────────────────────────────────────────────────
#
# This file is the CREDENTIAL STORE.  The primary interface for configuring
# which connectors are active is viewpoint.config.ts (see
# viewpoint.config.example.ts for a template).  The config file references
# these variables by NAME; their VALUES live here and in the deployment's
# secret manager.
#
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  VITE_ PREFIX RULE
# ─────────────────────────────────────────────────────────────────────────────
#
# Any variable prefixed VITE_ is INLINED INTO THE CLIENT BUNDLE by Vite at
# build time and shipped to every browser that loads the app.  A secret in a
# VITE_ variable is a PUBLIC secret.
#
# The ONLY approved VITE_ variables in this project are:
#
#   VITE_SUPABASE_URL         — public Supabase project URL
#   VITE_SUPABASE_ANON_KEY    — public Supabase anon key (client-safe by
#                                design; access control is enforced by Postgres
#                                Row Level Security, not by key secrecy)
#
# Every other credential MUST use an unprefixed name and be read only in
# server-side code (api/* functions or capture-service).  The master config
# schema enforces this: it rejects VITE_-prefixed names on all fields except
# db.urlEnv and db.anonKeyEnv.
#
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.  Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────


# ── PLM — Onshape ────────────────────────────────────────────────────────────
# Onshape OAuth application credentials.
# Create an Onshape dev account at https://dev-portal.onshape.com/

# Server-only — Onshape OAuth client ID
ONSHAPE_CLIENT_ID=your_onshape_client_id

# Server-only — Onshape OAuth client secret
ONSHAPE_CLIENT_SECRET=your_onshape_client_secret


# ── PLM — Teamcenter (alternative to Onshape) ────────────────────────────────
# Siemens Teamcenter credentials.

# Server-only — Teamcenter service username
TC_USERNAME=your_teamcenter_username

# Server-only — Teamcenter service password
TC_PASSWORD=your_teamcenter_password


# ── TURN — Cloudflare ────────────────────────────────────────────────────────
# Cloudflare Calls TURN service for WebRTC relay.

# Server-only — TURN application token ID
CF_TURN_TOKEN_ID=your_cloudflare_turn_token_id

# Server-only — TURN API token (secret)
CF_TURN_API_TOKEN=your_cloudflare_turn_api_token


# ── TURN — self-hosted coturn (alternative to Cloudflare) ────────────────────

# Server-only — coturn shared secret
COTURN_SHARED_SECRET=your_coturn_shared_secret


# ── Database — Supabase ──────────────────────────────────────────────────────
# Supabase project connection.  Both are VITE_-prefixed because the browser
# reads them directly.  The anon key is client-safe by design — access control
# is enforced by Postgres Row Level Security.

# PUBLIC (client bundle) — Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# PUBLIC (client bundle) — Supabase anon key (RLS-protected, not a secret)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key


# ── Notifications — Microsoft Teams ──────────────────────────────────────────
# Incoming webhook URL for Teams channel notifications.

# Server-only — Teams incoming webhook URL (bearer credential)
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/...
